TRAIN_DB_PASSWORD=changeme

# Optional. These default to the production setup (a local database called
# train_delay_db owned by trainuser).
# TRAIN_DB_HOST=localhost
# TRAIN_DB_NAME=train_delay_db
# TRAIN_DB_USER=trainuser

# Where monitor.py POSTs an alert when a poller check fails. Any endpoint
# that accepts a POST body works - an ntfy.sh topic, a healthchecks.io fail
# URL, a Slack/Discord webhook. Leave unset to disable alerting entirely
# (monitor.py still logs and still writes monitor_status.json).
ALERT_WEBHOOK_URL=

# Web Push (VAPID). Optional - leave blank and delay alerts are simply
# unavailable; everything else runs normally. Generate a pair with:
#   python3 -c "import base64;from cryptography.hazmat.primitives.asymmetric import ec;from cryptography.hazmat.primitives import serialization as s;k=ec.generate_private_key(ec.SECP256R1());b=lambda x:base64.urlsafe_b64encode(x).decode().rstrip('=');print('VAPID_PRIVATE_KEY='+b(k.private_bytes(s.Encoding.DER,s.PrivateFormat.PKCS8,s.NoEncryption())));print('VAPID_PUBLIC_KEY='+b(k.public_key().public_bytes(s.Encoding.X962,s.PublicFormat.UncompressedPoint)))"
# Changing these invalidates every existing browser subscription.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:you@example.com
