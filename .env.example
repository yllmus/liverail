TRAIN_DB_PASSWORD=changeme

# Where monitor.py POSTs an alert when a poller check fails. Any endpoint
# that accepts a POST body works - an ntfy.sh topic, a healthchecks.io fail
# URL, a Slack/Discord webhook. Leave unset to disable alerting entirely
# (monitor.py still logs and still writes monitor_status.json).
ALERT_WEBHOOK_URL=
